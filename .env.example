# 数据库配置
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=jlpt

# LLM API 配置
DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# langchain ChatOpenAI 用的 OpenAI 兼容基址（代码和 README 都用到，之前漏在这里）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 爬虫账号配置
SPIDER_BASE_URL=http://account.for-test.cn
SPIDER_USERNAME=your_email
SPIDER_PASSWORD=your_password

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 运行环境：production 时收敛 CORS 并关闭 /docs、/redoc、/openapi.json
# 本地开发留 development
ENV=development

# 允许的跨域来源，逗号分隔，必须与 deploy/nginx.conf 的 server_name 一致。
# 生产示例：ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
# 留空时：development 回落到 localhost:5173/5174；production 不挂 CORS 中间件
#（同域部署适用）。任何情况下都不会回落成 "*"。
ALLOWED_ORIGINS=

# JWT 签名密钥（生产环境请换成随机长字符串：openssl rand -hex 32）
JWT_SECRET=change_me_to_a_random_secret

# 日志级别：DEBUG / INFO / WARNING / ERROR
# 生产输出单行 JSON，开发输出人类可读文本，都只写 stdout（交给 docker logs）
LOG_LEVEL=INFO

# 学生端在宿主机上的端口。80 被别的服务占用时改这里（如 8000），
# 或让已有的 nginx 反代过来，见 deploy/README.md
HTTP_PORT=80

# 限流配额（进程内计数，单 worker 有效；留空用默认值）
# 登录按 IP 计数，挡撞库；LLM 按用户计数，挡刷 DeepSeek 成本
RATELIMIT_LOGIN_PER_MIN=10
RATELIMIT_REGISTER_PER_HOUR=20
RATELIMIT_LLM_PER_MIN=10

# ===== 仅生产部署用（docker-compose.prod.yml 读取）=====
# 听力音频基址。
#
# ⚠️ 必须显式填，否则听力题音频全部 404（且不报错）。
# 本地开发能播是靠 student/.env，但那个文件被 .dockerignore 排除、不进构建
# 上下文，容器里读不到——留空的话音频路径会退化成 /mp3/...，落到 nginx 挂载的
# AUDIO_DIR 空目录。
#
# 用源站（IP + HTTP 试运行阶段最省事）：
#   VITE_AUDIO_BASE_URL=http://account.for-test.cn
# 自己托管音频时才留空，并把 mp3 放进 AUDIO_DIR。
#
# 注意 Vite 构建期把它静态内联进产物，改完必须重新 build nginx 镜像。
VITE_AUDIO_BASE_URL=http://account.for-test.cn
# 宿主机音频目录，挂载到 nginx 的 /srv/audio（只读）
AUDIO_DIR=./audio
